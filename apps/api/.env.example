# ── Database ────────────────────────────────────────────────────────────────
# Runtime role: not the owner of any table, NOBYPASSRLS. Everything the API does goes through it.
DATABASE_URL=postgresql://appraisal_app:app_dev_password@localhost:5432/appraisal
# Schema owner: used only by `prisma migrate` and the catalog sync.
MIGRATOR_DATABASE_URL=postgresql://appraisal_migrator:migrator_dev_password@localhost:5432/appraisal
# Superuser: used once by scripts/db-bootstrap.ts to create the two roles and the databases.
POSTGRES_SUPERUSER_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Integration/e2e tests use their own database (created by the bootstrap script).
TEST_DATABASE_NAME=appraisal_test

# ── HTTP / tenancy ──────────────────────────────────────────────────────────
PORT=3000
# Tenants live on <slug>.BASE_DOMAIN; the platform console on admin.BASE_DOMAIN.
BASE_DOMAIN=localhost
COOKIE_SECURE=false
# Set to 1 when running behind a reverse proxy that sets X-Forwarded-* (docker/nginx).
TRUST_PROXY=0

# ── Auth ────────────────────────────────────────────────────────────────────
# Two independent keys: a tenant token can never verify as a platform token (ADR-005).
TENANT_JWT_SECRET=change-me-tenant-secret-at-least-32-characters
PLATFORM_JWT_SECRET=change-me-platform-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# ── Noisy-neighbour controls (T9 / experiment E4) ───────────────────────────
RATE_LIMIT_PER_TENANT_PER_MINUTE=1200
STATEMENT_TIMEOUT_MS=5000

# ── Test-only switch for experiment E1 v2: disables the Prisma tenant filter (layer 2)
# so the matrix proves RLS alone still isolates. Refused when NODE_ENV=production.
TENANCY_APP_FILTER=on

LOG_LEVEL=info
