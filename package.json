{
  "name": "appraisal-saas",
  "private": true,
  "description": "Multi-tenant performance-appraisal SaaS: shared schema + PostgreSQL RLS, modular NestJS monolith, React front-end.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel --filter ./apps/* run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "boundaries": "pnpm --filter @appraisal/api run boundaries",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "db:reset": "pnpm --filter @appraisal/api run db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "typescript-eslint": "^8.40.0",
    "globals": "^16.3.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "~5.9.0"
  }
}
