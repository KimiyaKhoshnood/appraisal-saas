{
  "name": "@appraisal/api",
  "version": "0.1.0",
  "private": true,
  "description": "Modular NestJS monolith: tenancy, platform, iam, configuration, organization, evaluation, reporting, audit.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src test prisma scripts",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "boundaries:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot --collapse \"^src/modules/[^/]+\" > ../../docs/module-graph.dot",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node -r @swc-node/register prisma/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:cov": "vitest run --coverage",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:catalog": "tsx prisma/sync-catalog.ts"
  },
  "dependencies": {
    "@appraisal/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cookie-parser": "^1.4.7",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.7.0",
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.0",
    "dependency-cruiser": "^17.0.0",
    "dotenv": "^17.2.0",
    "pino-pretty": "^13.1.0",
    "prisma": "^7.10.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.0.0"
  }
}
