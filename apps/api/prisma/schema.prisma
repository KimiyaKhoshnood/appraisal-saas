// Data model for the multi-tenant appraisal SaaS.
//
// Two scopes, never mixed (see docs/architecture.md, "Domain model"):
//   * PLATFORM tables have no tenant_id and no RLS.
//   * TENANT tables all carry tenant_id, are protected by FORCE ROW LEVEL SECURITY
//     (policies live in the SQL migrations) and reference each other only through
//     composite (tenant_id, id) foreign keys, so a row of tenant A can never point at
//     a row of tenant B even if application code tries to.
//
// Ids are UUIDv7 generated by PostgreSQL 18 (`uuidv7()`): unguessable, yet time-ordered,
// which makes them good keyset-pagination cursors and keeps B-tree inserts append-only.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── PLATFORM SCOPE ─────────────────────────────

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Read-only permission catalog, seeded from @appraisal/contracts.
model Permission {
  key         String @id
  description String

  rolePermissions RolePermission[]

  @@map("permission")
}

model FeatureDefinition {
  key         String @id
  description String

  plans PlanFeature[]

  @@map("feature_definition")
}

model Plan {
  code      String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  features PlanFeature[]
  tenants  Tenant[]

  @@map("plan")
}

model PlanFeature {
  planCode   String @map("plan_code")
  featureKey String @map("feature_key")

  plan    Plan              @relation(fields: [planCode], references: [code], onDelete: Cascade)
  feature FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([planCode, featureKey])
  @@map("plan_feature")
}

model Tenant {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  /// Immutable after creation: the sub-domain is part of the brand and of the security model.
  slug        String       @unique
  planCode    String       @map("plan_code")
  status      TenantStatus @default(PROVISIONING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  suspendedAt DateTime?    @map("suspended_at") @db.Timestamptz(3)

  plan      Plan             @relation(fields: [planCode], references: [code])
  directory TenantDirectory?

  // Root tenant-scoped tables reference the tenant; their children reference them through
  // composite (tenant_id, id) keys, so the whole tree is anchored to one existing tenant.
  settings    TenantSettings?
  authzState  TenantAuthzState?
  features    TenantFeature[]
  branding    TenantBranding?
  users       User[]
  roles       Role[]
  departments Department[]
  cycles      EvaluationCycle[]
  auditLogs   AuditLog[]

  @@map("tenant")
}

/// tenant → shard. Everything points at `primary` today; the table exists so that moving a
/// large tenant to a dedicated database later is a data change, not a redesign.
model TenantDirectory {
  tenantId String @id @map("tenant_id") @db.Uuid
  shard    String @default("primary")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_directory")
}

/// Platform operators are a separate identity (ADR-005): own table, own JWT key and audience.
model PlatformAdmin {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)

  refreshTokens PlatformRefreshToken[]

  @@map("platform_admin")
}

model PlatformRefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  adminId      String    @map("admin_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("platform_refresh_token")
}

model PlatformAuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name")
  category   String   @default("CHANGE")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("platform_audit_log")
}

// ────────────────────────────── TENANT SCOPE ──────────────────────────────
// Every model below: tenant_id column, @@unique([tenantId, id]) as FK target,
// indexes that start with tenant_id, RLS policy `tenant_isolation`.

model TenantSettings {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  /// Versioned JSON document validated by tenantSettingsDocumentSchema (Zod) on every write.
  settings      Json     @default("{\"schemaVersion\":1,\"evaluation\":{}}")
  /// Bumped on every configuration change; part of the in-process cache key (no invalidation bus needed).
  configVersion Int      @default(1) @map("config_version")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

/// Owned by iam. Bumped on every role, permission, assignment or user-status change; part of the
/// permission cache key, so a change is visible on the very next request on every replica.
model TenantAuthzState {
  tenantId String @id @map("tenant_id") @db.Uuid
  version  Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_authz_state")
}

model TenantFeature {
  tenantId   String  @map("tenant_id") @db.Uuid
  featureKey String  @map("feature_key")
  enabled    Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, featureKey])
  @@map("tenant_feature")
}

model TenantBranding {
  tenantId       String  @id @map("tenant_id") @db.Uuid
  appName        String  @map("app_name")
  logoUrl        String? @map("logo_url")
  primaryColor   String  @map("primary_color")
  secondaryColor String  @map("secondary_color")
  locale         String  @default("en")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_branding")
}

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Unique per tenant, not globally: the same address may exist in two organisations.
  email        String
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         UserRole[]
  refreshTokens RefreshToken[]
  profile       EmployeeProfile?  @relation("ProfileUser")
  reports       EmployeeProfile[] @relation("ProfileManager")
  evaluations   Evaluation[]      @relation("EvaluationEmployee")
  managed       Evaluation[]      @relation("EvaluationManager")
  approvals     ApprovalRecord[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@map("app_user")
}

model Role {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  /// TENANT_ADMIN | MANAGER | EMPLOYEE for roles created from a system template; null for custom roles.
  systemKey String? @map("system_key")

  permissions RolePermission[]
  users       UserRole[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("role")
}

model RolePermission {
  tenantId      String @map("tenant_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([tenantId, roleId, permissionKey])
  @@map("role_permission")
}

model UserRole {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId, roleId])
  @@index([tenantId, roleId])
  @@map("user_role")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// All tokens descending from one login share a family; reuse of a rotated token revokes the family.
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 of the secret part; the secret itself is never stored.
  tokenHash    String    @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, familyId])
  @@map("refresh_token")
}

model Department {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  employees EmployeeProfile[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("department")
}

/// Where a user stands in the organisation. Kept apart from User (identity) on purpose:
/// evaluation needs the reporting line, not the login table.
model EmployeeProfile {
  tenantId     String  @map("tenant_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  managerId    String? @map("manager_id") @db.Uuid
  jobTitle     String? @map("job_title")

  user       User        @relation("ProfileUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  manager    User?       @relation("ProfileManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenantId, userId])
  @@index([tenantId, managerId])
  @@index([tenantId, departmentId])
  @@map("employee_profile")
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model EvaluationCycle {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  name           String
  status         CycleStatus @default(DRAFT)
  startsOn       DateTime    @map("starts_on") @db.Date
  endsOn         DateTime    @map("ends_on") @db.Date
  /// Effective policy frozen when the cycle is created: later policy edits never change a running cycle.
  policySnapshot Json        @map("policy_snapshot")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt    DateTime?   @map("activated_at") @db.Timestamptz(3)
  closedAt       DateTime?   @map("closed_at") @db.Timestamptz(3)

  competencies Competency[]
  evaluations  Evaluation[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, startsOn(sort: Desc)])
  @@map("evaluation_cycle")
}

model Competency {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  cycleId     String  @map("cycle_id") @db.Uuid
  name        String
  description String?
  weight      Int
  position    Int

  cycle  EvaluationCycle   @relation(fields: [tenantId, cycleId], references: [tenantId, id], onDelete: Cascade)
  scores EvaluationScore[]

  @@unique([tenantId, id])
  @@index([tenantId, cycleId, position])
  @@map("competency")
}

enum EvaluationStatus {
  DRAFT
  SELF_SUBMITTED
  MANAGER_SUBMITTED
  PENDING_APPROVAL
  PUBLISHED
}

model Evaluation {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  cycleId     String           @map("cycle_id") @db.Uuid
  employeeId  String           @map("employee_id") @db.Uuid
  /// Manager at the time the cycle was activated; reporting lines may change later.
  managerId   String?          @map("manager_id") @db.Uuid
  status      EvaluationStatus @default(DRAFT)
  finalScore  Decimal?         @map("final_score") @db.Decimal(5, 2)
  /// Optimistic-concurrency counter: every transition is `UPDATE … WHERE version = $expected`.
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(3)

  cycle     EvaluationCycle   @relation(fields: [tenantId, cycleId], references: [tenantId, id], onDelete: Cascade)
  employee  User              @relation("EvaluationEmployee", fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  manager   User?             @relation("EvaluationManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  scores    EvaluationScore[]
  approvals ApprovalRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, cycleId, employeeId])
  @@index([tenantId, employeeId])
  @@map("evaluation")
}

enum EvaluatorKind {
  SELF
  MANAGER
}

model EvaluationScore {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  evaluationId String        @map("evaluation_id") @db.Uuid
  competencyId String        @map("competency_id") @db.Uuid
  evaluator    EvaluatorKind
  score        Int
  comment      String?

  evaluation Evaluation @relation(fields: [tenantId, evaluationId], references: [tenantId, id], onDelete: Cascade)
  competency Competency @relation(fields: [tenantId, competencyId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, evaluationId, competencyId, evaluator])
  @@map("evaluation_score")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model ApprovalRecord {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  evaluationId String           @map("evaluation_id") @db.Uuid
  approverId   String           @map("approver_id") @db.Uuid
  stage        Int
  decision     ApprovalDecision
  comment      String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  evaluation Evaluation @relation(fields: [tenantId, evaluationId], references: [tenantId, id], onDelete: Cascade)
  approver   User       @relation(fields: [tenantId, approverId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, evaluationId])
  @@map("approval_record")
}

/// Append-only: the runtime role has INSERT and SELECT only (AD-03, T12).
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  category   String
  action     String
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  requestId  String?  @map("request_id")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id(sort: Desc)])
  @@index([tenantId, category, id(sort: Desc)])
  @@map("audit_log")
}
